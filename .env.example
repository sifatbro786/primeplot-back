# ─────────────────────────────────────────────────────────────
# PrimePlot API — copy to .env and fill in. Never commit .env.
# Required keys are marked (required). Everything else has a default or is optional.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5030
APP_NAME=PrimePlot
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Nginx = 1)
TRUST_PROXY=1

# Frontend origin (CORS). Comma-separated extra origins in CORS_ORIGINS if needed.
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=

# (required) MongoDB Atlas connection string (must be a replica set — Atlas always is)
MONGODB_URI=
# (required) min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Single-tenant: slug of the organization this deployment serves (set by `npm run seed`).
# Empty = use the only organization in the database.
ORG_SLUG=

# ── Auth (defaults are sensible; change only with a reason) ──
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# "Remember me" sessions
REFRESH_REMEMBER_TTL_DAYS=30
# Hard cap for any session, however often it is refreshed
SESSION_ABSOLUTE_TTL_DAYS=60
AUDIT_RETENTION_DAYS=60

# ── Email (SMTP) — optional; email features stay disabled until set ──
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if empty, e.g. "PrimePlot <no-reply@example.com>"
SMTP_FROM=

# ── Storage ──
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Public base URL for media files. Dev default: http://localhost:<PORT>/uploads
# Production: https://api.<domain>/uploads (Nginx serves the uploads/public folder there)
PUBLIC_MEDIA_BASE_URL=
MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_DOC_MB=10

# ── Ops ──
# Secret header value for POST /api/v1/internal/cron/tick
CRON_SECRET=
# In-process job scheduler (emails, cleanups; later reminders, hold expiry)
JOBS_ENABLED=true
JOB_TICK_MS=30000
JOB_CONCURRENCY=2

# ── Inventory (B2) ──
# Default / maximum length of a unit hold (hours)
UNIT_HOLD_DEFAULT_HOURS=24
UNIT_HOLD_MAX_HOURS=72
# Active holds one person may keep at once (0 = no limit)
UNIT_HOLD_MAX_PER_USER=10

# ── Frontend revalidation (public site cache) ──
# Same value as REVALIDATE_SECRET in primeplot-front/.env.local (min 32 chars). Empty = off.
REVALIDATE_SECRET=
# Default: <CLIENT_URL>/api/revalidate
FRONTEND_REVALIDATE_URL=

# ── SSLCommerz — online payment stays hidden until both keys are set (B5.2) ──
# Sandbox: free store at https://developer.sslcommerz.com/registration/ → Store ID + Store Password
SSLCZ_STORE_ID=
SSLCZ_STORE_PASS=
# false = sandbox.sslcommerz.com (test cards) · true = securepay.sslcommerz.com (real money)
SSLCZ_IS_LIVE=false
# Public address of this API — SSLCommerz posts the IPN and the browser returns here:
#   <API_PUBLIC_URL>/api/v1/webhooks/sslcommerz/{ipn,success,fail,cancel}
# Dev: a tunnel such as https://xxxx.trycloudflare.com (see docs/SSLCOMMERZ.md). Prod: https://api.<domain>
API_PUBLIC_URL=

# ── SMS — `log` prints messages to the log instead of sending ──
# log | bulksmsbd | sslwireless
SMS_DRIVER=log
# bulksmsbd: API key from the panel · sslwireless: the SMS Plus api_token
SMS_API_KEY=
# Approved sender ID (masking name) or the non-masking number the provider gave you
SMS_SENDER_ID=
SMS_API_USER=
SMS_API_PASS=
# Optional: provider base URL override (defaults: https://bulksmsbd.net/api, https://smsplus.sslwireless.com)
SMS_API_URL=
# Optional: price of one SMS segment in poisha (35 = ৳0.35) — shown as the cost preview
SMS_COST_PER_SEGMENT_POISHA=

# ── Meta Lead Ads (Facebook / Instagram lead forms) ──
# From your Meta app (App settings › Basic). Both empty = feature off.
META_APP_ID=
META_APP_SECRET=
# Any long random string; paste the same value in the app's Webhooks › Verify token
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0

# ── Documents & PDF (B4.3) ──
# Website address printed in document QR codes (<site>/verify/<token>). Empty = CLIENT_URL
PUBLIC_SITE_URL=
# Empty = the Chrome that `npm install` downloaded. VPS example: /usr/bin/chromium
PDF_CHROME_PATH=
# true only when Chrome must run as root (typical VPS)
PDF_NO_SANDBOX=false
PDF_TIMEOUT_MS=30000
