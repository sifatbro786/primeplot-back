# ─────────────────────────────────────────────────────────────
# PrimePlot API — copy to .env and fill in. Never commit .env.
# Required keys are marked (required). Everything else has a default or is optional.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5030
APP_NAME=PrimePlot
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Nginx = 1)
TRUST_PROXY=1

# Frontend origin (CORS). Comma-separated extra origins in CORS_ORIGINS if needed.
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=

# (required) MongoDB Atlas connection string (must be a replica set — Atlas always is)
MONGODB_URI=
# (required) min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Single-tenant: slug of the organization this deployment serves (set by `npm run seed`).
# Empty = use the only organization in the database.
ORG_SLUG=

# ── Auth (defaults are sensible; change only with a reason) ──
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# "Remember me" sessions
REFRESH_REMEMBER_TTL_DAYS=30
# Hard cap for any session, however often it is refreshed
SESSION_ABSOLUTE_TTL_DAYS=60
AUDIT_RETENTION_DAYS=60

# ── Email (SMTP) — optional; email features stay disabled until set ──
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if empty, e.g. "PrimePlot <no-reply@example.com>"
SMTP_FROM=

# ── Storage ──
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Public base URL for media files. Dev default: http://localhost:<PORT>/uploads
# Production: https://api.<domain>/uploads (Nginx serves the uploads/public folder there)
PUBLIC_MEDIA_BASE_URL=
MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_DOC_MB=10

# ── Ops ──
# Secret header value for POST /api/v1/internal/cron/tick
CRON_SECRET=
# In-process job scheduler (emails, cleanups; later reminders, hold expiry)
JOBS_ENABLED=true
JOB_TICK_MS=30000
JOB_CONCURRENCY=2

# ── SSLCommerz — online payment stays hidden until both keys are set ──
SSLCZ_STORE_ID=
SSLCZ_STORE_PASS=
SSLCZ_IS_LIVE=false

# ── SMS — `log` prints messages to the log instead of sending ──
# log | bulksmsbd | sslwireless
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_USER=
SMS_API_PASS=
