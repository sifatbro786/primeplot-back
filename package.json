{
  "name": "primeplot-back",
  "version": "0.1.0",
  "private": true,
  "description": "PrimePlot \u2014 Real Estate Management & CRM API",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#shared/*": "./src/shared/*",
    "#modules/*": "./src/modules/*",
    "#integrations/*": "./src/integrations/*",
    "#jobs/*": "./src/jobs/*",
    "#sockets/*": "./src/sockets/*"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed-demo.js",
    "email:check": "node scripts/email-check.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.1.1",
    "fractional-indexing": "^3.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
